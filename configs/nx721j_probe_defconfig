# Minimal NX721J probe configuration.
# This file is intentionally not selected by the current sheng-derived board.toml.
# It enables only the generic XNU/DT/timer/UFS probe boundary; root, GPU, touch,
# panel, power and board-specific transport remain disabled until qualified.

CONFIG_XNU_ARM_DT_PLATFORM=y
CONFIG_XNU_ARMCPU=y
CONFIG_XNU_NATIVE_ARCH_TIMER=y
CONFIG_XNU_NATIVE_UFS=y
CONFIG_XNU_BOOT_PROGRESS=y

CONFIG_XNU_NATIVE_MOBILE_DISPLAY=n
CONFIG_XNU_NATIVE_LEGACY_DISPLAY=n
CONFIG_XNU_NATIVE_ADRENO=n
CONFIG_XNU_ARMVIRT_PLATFORM=n
